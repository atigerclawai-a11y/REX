      "path":     "~/Desktop/REX/website/app/layout.jsx",
      "min_kb":   1,
      "required": true
    },
    {
      "label":    "Global styles",
      "path":     "~/Desktop/REX/website/app/globals.css",
      "min_kb":   1,
      "required": true
    },
    {
      "label":    "Next.js config",
      "path":     "~/Desktop/REX/website/next.config.mjs",
      "min_kb":   1,
      "required": true
    },
    {
      "label":    "Tailwind config",
      "path":     "~/Desktop/REX/website/tailwind.config.js",
      "min_kb":   1,
      "required": true
