  "node_dependencies": {
    "check": "~/Desktop/REX/website/node_modules exists",
    "install_cmd": "cd ~/Desktop/REX/website && npm install",
    "key_packages": ["next", "react", "react-dom", "tailwindcss"]
  },

  "local_dev": {
    "start_cmd":  "cd ~/Desktop/REX/website && npm run dev",
    "default_port": 3000,
    "check_url":  "http://localhost:3000"
  },

  "deployment": {
    "current_status": "not yet deployed — confirm with Kato",
    "recommended":    "Netlify (drag-to-deploy or Git integration)",
    "domain_registrar": "Namecheap",
    "static_fallback": "GoldHealthSystems/index.html can be deployed independently with no build step"
  },

  "quick_fixes": {
    "node_modules_missing": "cd ~/Desktop/REX/website && npm install",
    "site_not_loading":     "cd ~/Desktop/REX/website && npm run dev",
    "need_static_backup":   "Open GoldHealthSystems/index.html directly in browser"
  }
