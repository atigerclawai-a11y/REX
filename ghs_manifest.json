  "components": [
    { "file": "Nav.jsx",       "purpose": "Sticky header with scroll-spy navigation" },
    { "file": "Hero.jsx",      "purpose": "Above-the-fold hero section" },
    { "file": "About.jsx",     "purpose": "About GHS section" },
    { "file": "Features.jsx",  "purpose": "Services / feature highlights" },
    { "file": "Process.jsx",   "purpose": "How it works / process flow" },
    { "file": "Proof.jsx",     "purpose": "Social proof / testimonials" },
