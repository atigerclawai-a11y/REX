    "website_components": "~/Desktop/REX/website/components",
    "website_app":      "~/Desktop/REX/website/app",
    "context_docs":     "~/Desktop/REX"
  },

  "landing_page_versions": {
    "active": "nextjs",
    "versions": [
      {
        "id":       "static_html",
        "label":    "Static HTML site (legacy)",
