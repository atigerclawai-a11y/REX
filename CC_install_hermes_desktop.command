#!/bin/bash
# CC_install_hermes_desktop.command
# Installs Hermes desktop app from DMG, removes GateKeeper quarantine,
# applies GHS logo icon, creates launcher pointed at gateway port 3002

LOG="$HOME/Desktop/REX/logs/CC_install_hermes_desktop_$(date +%Y%m%d_%H%M%S).log"
mkdir -p "$HOME/Desktop/REX/logs"
exec > >(tee "$LOG") 2>&1

GREEN='\033[0;32m'; RED='\033[0;31m'; YELLOW='\033[1;33m'
CYAN='\033[0;36m'; BOLD='\033[1m'; NC='\033[0m'
ok()   { echo -e "${GREEN}✅  $1${NC}"; }
fail() { echo -e "${RED}❌  $1${NC}"; echo ""; echo "Log: $LOG"; echo "Press any key..."; read -n 1; exit 1; }
warn() { echo -e "${YELLOW}⚠️   $1${NC}"; }
info() { echo -e "${CYAN}ℹ️   $1${NC}"; }

echo -e "${BOLD}╔════════════════════════════════════════════════════╗${NC}"
echo -e "${BOLD}║   Hermes Desktop — Install + GHS Logo + Launch     ║${NC}"
echo -e "${BOLD}╚════════════════════════════════════════════════════╝${NC}"
echo ""

DMG="$HOME/Downloads/Hermes-Setup.dmg"
ICON_PNG="/tmp/hermes_ghs_logo.png"
ICONSET="/tmp/hermes_ghs.iconset"
ICNS="/tmp/hermes_ghs.icns"

# ── STEP 1: Write GHS logo from embedded data ──────────────────────────────────
info "Writing GHS logo icon..."
python3 - << 'PYEOF'
import base64
data = """"""
with open('/tmp/hermes_ghs_logo.png','wb') as f:
    f.write(base64.b64decode(data))
print("  GHS logo PNG written.")
PYEOF
ok "GHS logo ready"

# ── STEP 2: Convert to .icns ───────────────────────────────────────────────────
info "Converting to .icns..."
rm -rf "$ICONSET" && mkdir -p "$ICONSET"
for SIZE in 16 32 64 128 256 512; do
    sips -z $SIZE $SIZE "$ICON_PNG" --out "$ICONSET/icon_${SIZE}x${SIZE}.png" &>/dev/null
done
for SIZE in 32 64 256 512; do
    HALF=$((SIZE/2))
    cp "$ICONSET/icon_${SIZE}x${SIZE}.png" "$ICONSET/icon_${HALF}x${HALF}@2x.png" 2>/dev/null
done
iconutil -c icns "$ICONSET" -o "$ICNS" 2>/dev/null
[ -f "$ICNS" ] && ok "GHS .icns created" || warn "iconutil failed — will skip icon swap"

# ── STEP 3: Check if already installed ────────────────────────────────────────
DEST=""
for CANDIDATE in /Applications/Hermes.app /Applications/hermes.app; do
    if [ -d "$CANDIDATE" ]; then
        DEST="$CANDIDATE"
        ok "Already installed: $DEST"
        break
    fi
done

# ── STEP 4: Install from DMG if not already installed ─────────────────────────
if [ -z "$DEST" ]; then
    info "Installing from DMG..."
    [ -f "$DMG" ] || fail "DMG not found at: $DMG"

    MOUNT_PT="/tmp/hermes-dmg-mount"
    mkdir -p "$MOUNT_PT"

    # Remove quarantine from DMG first
    xattr -d com.apple.quarantine "$DMG" 2>/dev/null

    hdiutil attach "$DMG" -mountpoint "$MOUNT_PT" -nobrowse -quiet
    [ $? -eq 0 ] || fail "Could not mount DMG"
    ok "DMG mounted"

    APP_IN_DMG=$(find "$MOUNT_PT" -maxdepth 2 -name "*.app" 2>/dev/null | head -1)
    [ -n "$APP_IN_DMG" ] || { hdiutil eject "$MOUNT_PT" -quiet; fail "No .app in DMG. Contents: $(ls $MOUNT_PT)"; }

    APP_NAME=$(basename "$APP_IN_DMG")
    DEST="/Applications/$APP_NAME"
    info "Copying $APP_NAME → /Applications/"
    cp -r "$APP_IN_DMG" /Applications/
    hdiutil eject "$MOUNT_PT" -quiet 2>/dev/null
    ok "Installed: $DEST"
fi

# ── STEP 5: Remove GateKeeper quarantine ─────────────────────────────────────
info "Removing GateKeeper quarantine..."
xattr -cr "$DEST" 2>/dev/null
ok "Quarantine cleared (GateKeeper bypass)"

# ── STEP 6: Apply GHS logo icon ───────────────────────────────────────────────
if [ -f "$ICNS" ] && [ -d "$DEST/Contents/Resources" ]; then
    info "Applying GHS logo icon..."
    for ICON_FILE in "$DEST/Contents/Resources"/*.icns; do
        [ -f "$ICON_FILE" ] || continue
        cp "$ICON_FILE" "${ICON_FILE}.orig.bak" 2>/dev/null
        cp "$ICNS" "$ICON_FILE"
        info "  Replaced: $(basename $ICON_FILE)"
    done
    touch "$DEST"
    /System/Library/Frameworks/CoreServices.framework/Versions/A/Frameworks/LaunchServices.framework/Versions/A/Support/lsregister -f "$DEST" 2>/dev/null
    ok "GHS logo applied to app icon"
    # Re-clear quarantine after icon swap (icon replacement can re-trigger GateKeeper)
    xattr -cr "$DEST" 2>/dev/null
    # Ad-hoc codesign so macOS stops treating it as damaged
    codesign --force --deep --sign - "$DEST" 2>/dev/null &&         ok "App re-signed (GateKeeper bypass permanent)" ||         warn "codesign failed — app may still show GateKeeper warning"
fi

# ── STEP 7: Create gateway-aware launcher ─────────────────────────────────────
LAUNCHER="$HOME/Desktop/REX/CC_launch_hermes_desktop.command"
cat > "$LAUNCHER" << 'LAUNCHEOF'
#!/bin/bash
# CC_launch_hermes_desktop.command — opens Hermes desktop → gateway port 3002
HERMES_API_URL=http://127.0.0.1:3002 \
HERMES_DASHBOARD_URL=http://127.0.0.1:9120 \
open "__APP_PATH__"
LAUNCHEOF
sed -i '' "s|__APP_PATH__|${DEST}|g" "$LAUNCHER"
chmod +x "$LAUNCHER"
ok "Launcher created: $LAUNCHER"

# ── STEP 8: Launch ────────────────────────────────────────────────────────────
info "Launching Hermes desktop..."
HERMES_API_URL=http://127.0.0.1:3002 HERMES_DASHBOARD_URL=http://127.0.0.1:9120 open "$DEST"

echo ""
echo -e "${BOLD}╔════════════════════════════════════════════════════╗${NC}"
echo -e "${BOLD}║   Hermes Desktop — Done ✅                         ║${NC}"
echo -e "${BOLD}╚════════════════════════════════════════════════════╝${NC}"
echo ""
echo -e "  App:      ${CYAN}$DEST${NC}"
echo -e "  Gateway:  port 3002 (Telegram bots wired)"
echo -e "  Icon:     GHS logo (Gold Health Systems)"
echo -e "  Launcher: ~/Desktop/REX/CC_launch_hermes_desktop.command"
echo ""
echo "Log: $LOG"
echo ""; echo "Press any key..."; read -n 1
