<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.goj.drive_signin_sync</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/mainsobhelper/.rex-venv/bin/python3</string>
        <string>/Users/mainsobhelper/Desktop/REX/CC_drive_signin_sync.py</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/mainsobhelper/Desktop/REX</string>

    <key>RunAtLoad</key>
    <true/>

    <!-- Every 5 minutes -->
    <key>StartInterval</key>
