        <string>/Users/mainsobhelper</string>
        <key>PATH</key>
        <string>/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
        <key>REQUESTS_CA_BUNDLE</key>
        <string>/etc/ssl/cert.pem</string>
        <key>SSL_CERT_FILE</key>
        <string>/etc/ssl/cert.pem</string>
    </dict>
</dict>
</plist>
